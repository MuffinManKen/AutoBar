		<Intersect ftype="muffin_data" field="item_type" value="Consumable" />
		<Intersect ftype="muffin_data" field="tooltip_single" pattern="well fed|increase|gain " />
		<Exclusion ftype="muffin_data" field="tooltip_single" pattern="restores? [\d,]+%? (?:of your (?:maximum )?)?(?:health(?: and (?:[\d,]+%? )?mana)?|mana and (?:[\d,]+%? )?health)(?: every second)? (?:over|per second for)|heals? [\d,]+ damage" />
