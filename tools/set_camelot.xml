	<Set name="Muffin.Food.Feast">
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="set out a [\D]+ feast" />
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="place a [\D]+ feast" />
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="feed up to [\d]+ people" />
		<Intersect ftype="muffin_data" field="item_type" value="Consumable" />
	</Set>

	<Set name="Muffin.Gear.Trinket.Usable">
		<Inclusion ftype="muffin_data" field="item_equip_location" value="INVTYPE_TRINKET" />
		<Intersect ftype="muffin_data" field="tooltip_single" pattern="\buse:" />
		<Exclusion ftype="muffin_data" field="item_name" pattern="boss x loot x|\btest item\b" />
	</Set>
	<Set name="Muffin.Gear.Trinket.Nonusable">
		<Inclusion ftype="muffin_data" field="item_equip_location" value="INVTYPE_TRINKET" />
		<Exclusion ftype="muffin_data" field="tooltip_single" pattern="\buse:" />
		<Exclusion ftype="muffin_data" field="item_name" pattern="boss x loot x|\btest item\b" />
	</Set>

	<Set name="Muffin.Misc.Hearth">
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="teleports the caster|returns you to.*hearthstone location|recalls you to" />
	</Set>

	<Set name="Muffin.Misc.Openable">
		<!-- This only catches items that self-describe their open/create effect in their tooltip. Plain lockboxes/loot -->
		<!-- sacks have no such text (and no static signal at all); those are instead caught live by Dynamic.Openable, -->
		<!-- which AutoBarSearch:ScanBag() grows from C_Container.GetContainerItemInfo().hasLoot as the player encounters them. -->
		<Inclusion ftype="muffin_data" field="item_name" pattern="cache of treasures" />
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="open the container|open the nightmare pod|open the bag|open the clam|create a soulbound|create a class set item|create a broken isles item|create an uncommon|what(?:'s| is) inside|collect \d+[\s\w']*crests?" />
		<Exclusion ftype="muffin_data" field="tooltip_single" neg_pattern="\buse:" />
		<Exclusion ftype="muffin_data" field="tooltip_single" pattern="adds this toy" />
	</Set>

	<Set name="Muffin.Misc.Quest">
		<Inclusion ftype="muffin_data" field="item_type" pattern="Quest"/>
		<Exclusion ftype="muffin_data" field="tooltip_single" neg_pattern="use" />
	</Set>

	<Set name="Muffin.Misc.StartsQuest">
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="This Item Begins a Quest" />
	</Set>
	<Set name="Muffin.Misc.Reputation">
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="use:.*reputation" />
	</Set>



