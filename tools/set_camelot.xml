<SetFile url_root="https://www.wowhead.com/forever/">

	<Set name="Muffin.Drum.Haste">
		<Inclusion ftype="muffin_data" field="item_name" pattern="drum" />
		<Intersect ftype="muffin_data" field="tooltip_single" pattern="haste" />
		<Intersect ftype="muffin_data" field="item_type" value="Consumable" />
	</Set>


	<Set name="Muffin.Elixir.Battle">
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="battle elixir" />
		<Intersect ftype="muffin_data" field="item_type" value="Consumable" />
		<Exclusion ftype="muffin_data" field="tooltip_single" pattern="counts as" />
	</Set>
	<Set name="Muffin.Elixir.Guardian">
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="guardian elixir" />
		<Intersect ftype="muffin_data" field="item_type" value="Consumable" />
		<Exclusion ftype="muffin_data" field="tooltip_single" pattern="counts as" />
	</Set>


	<Set name="Muffin.Explosives">
		<Inclusion ftype="muffin_data" field="item_name" pattern="bomb|dynamite|\bcharge\b|explosive|grenade|land mine|mortar|big one|bigger one|blastpack|big daddy|landshark|\brocket\b|powderkeg|seaforium" />
		<Intersect ftype="muffin_data" field="item_type" value="Consumable" />
		<Intersect ftype="muffin_data" field="tooltip_single" pattern="\buse:" />
		<Exclusion ftype="muffin_data" field="tooltip_single" pattern="curio|recipe|alcoholic beverage|adds this toy|champion equipment|restores? [\d,]+%? (?:of your )?(?:maximum )?(?:health|mana)|add the explosive affix|quest item|\bequip\b|unlocks the|summons the assistance|launch yourself|gain \d+.*mana|firework|carousel|mohawk|party favor|guided rocket kit|cluster launcher" />
	</Set>

	<Set name="Muffin.Flask">
		<Inclusion ftype="muffin_data" field="item_sub_type" value="Flasks &amp; Phials" />
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="counts as both" />
		<Intersect ftype="muffin_data" field="item_type" value="Consumable" />
	</Set>

	<Set name="Muffin.Food.Health.Basic">
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="restores? [\d,]+%? (?:of your (?:maximum )?)?(?:health(?: and (?:[\d,]+%? )?mana)?|mana and (?:[\d,]+%? )?health)(?: every second)? (?:over|per second for)" />
		<Intersect ftype="muffin_data" field="item_type" value="Consumable" />
		<Exclusion ftype="muffin_data" field="tooltip_single" pattern="mana" />
		<Exclusion ftype="muffin_data" field="tooltip_single" pattern="well fed|increase|gain " />
	</Set>
	<Set name="Muffin.Food.Mana.Basic">
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="restores? [\d,]+%? (?:of your (?:maximum )?)?(?:mana(?: and (?:[\d,]+%? )?health)?|health and (?:[\d,]+%? )?mana)(?: every second)? (?:over|per second for)" />
		<Intersect ftype="muffin_data" field="item_type" value="Consumable" />
		<Exclusion ftype="muffin_data" field="tooltip_single" pattern="restores? [\d,]+%? (?:of your (?:maximum )?)?(?:health(?: and (?:[\d,]+%? )?mana)?|mana and (?:[\d,]+%? )?health)(?: every second)? (?:over|per second for)|heals? [\d,]+ damage" />
		<Exclusion ftype="muffin_data" field="tooltip_single" pattern="well fed|increase|gain " />
