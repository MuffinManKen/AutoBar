	<Set name="Muffin.Food.Combo.Buff">
		<Inclusion ftype="muffin_data" field="tooltip_single" pattern="restores? [\d,]+%? (?:of your (?:maximum )?)?(?:health(?: and (?:[\d,]+%? )?mana)?|mana and (?:[\d,]+%? )?health)(?: every second)? (?:over|per second for)|heals? [\d,]+ damage" />
		<Intersect ftype="muffin_data" field="tooltip_single" pattern="restores? [\d,]+%? (?:of your (?:maximum )?)?(?:mana(?: and (?:[\d,]+%? )?health)?|health and (?:[\d,]+%? )?mana)(?: every second)? (?:over|per second for)" />
